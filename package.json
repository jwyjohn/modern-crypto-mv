{
  "name": "mv-mi50-inference",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render MVInference out/MI50_MV.mp4",
    "timeline": "node scripts/export_timeline.mjs",
    "audio:mp3": "npx remotion ffmpeg -hide_banner -loglevel error -y -i public/sfx.wav -codec:a libmp3lame -b:a 128k public/sfx.mp3 && cp public/sfx.mp3 web-public/sfx.mp3",
    "typecheck": "tsc --noEmit -p .",
    "web:dev": "vite",
    "web:build": "vite build",
    "web:preview": "vite preview",
    "render:classic": "remotion render MVInferenceClassic out/MI50_MV_classic.mp4",
    "sfx": "node scripts/export_timeline.mjs && .venv/bin/python audio/make_sfx.py audio/timeline.json public/sfx.wav"
  },
  "dependencies": {
    "@remotion/bundler": "^4.0.529",
    "@remotion/cli": "^4.0.529",
    "@remotion/player": "^4.0.529",
    "@remotion/renderer": "^4.0.529",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "^4.0.529"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
